{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "acf/text-media",
	"title": "Text and media",
	"description": "Text next to an image, with the image on the left or right.",
	"category": "ny-blocks",
	"icon": "align-pull-left",
	"keywords": [ "image", "columns", "split" ],
	"textdomain": "ny-blank-theme",
	"acf": {
		"blockVersion": 3,
		"mode": "preview",
		"renderTemplate": "render.php"
	},
	"supports": {
		"align": false,
		"anchor": true,
		"html": false,
		"customClassName": false,
		"customCSS": false,
		"color": false,
		"spacing": false,
		"typography": false,
		"jsx": true
	}
}
